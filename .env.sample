# Authentication
JWT_SECRET=your_long_random_secret_key


# Master cluster configuration
MASTER_NODE_COUNT=3
MASTER_HOST=127.0.0.1

MASTER_HTTP_BASE_PORT=3001
MASTER_GRPC_BASE_PORT=4001
MASTER_RAFT_BASE_PORT=7001

MASTER_DATA_DIR_BASE=data/masters
MASTER_RAFT_BOOTSTRAP=true

# Storage nodes connect to all master gRPC servers
MASTER_ADDRESSES=localhost:4001,localhost:4002,localhost:4003


# Storage node configuration
STORAGE_NODE_COUNT=4
STORAGE_NODE_BASE_PORT=5001
STORAGE_NODE_HOST=localhost
STORAGE_NODE_DATA_DIR=data/nodes


# Heartbeat configuration
HEARTBEAT_INTERVAL=20s
HEARTBEAT_FAILURE_THRESHOLD=3
MONITOR_INTERVAL=20s